# Dev'de gerek yok (Vite proxy /api -> backend yönlendirir). Prod build'de backend farklı origin'deyse doldur.
VITE_API_BASE_URL=/api

# "onprem" (varsayılan, installer build'i) | "saas" (Docker imajı — Portal SSO, Kurulum
# Sihirbazı ve Kullanıcılar sayfası kapalı, cookie tabanlı auth).
VITE_AUTH_MODE=onprem
