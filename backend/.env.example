# ============================================
# OPERON PUANTAJ — BACKEND ORTAM DEĞİŞKENLERİ
# ============================================
# Bu dosyayı .env olarak kopyala, gerçek değerleri gir. .env asla commit edilmez.

APP_ENV=development

# ============================================
# VERİTABANI — PostgreSQL (SaaS ve on-prem'de aynı motor)
# ============================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/operon_puantaj
DB_POOL_SIZE=5

# ============================================
# AUTH — Faz 1: yerel kullanıcı adı/şifre + JWT
# ============================================
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# SUNUCU
# ============================================
API_PORT=8020
CORS_ORIGINS=http://localhost:5174
